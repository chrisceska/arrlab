# =============================================================================
# ARR Homelab Stack — Environment Configuration Template
# Copy this file to .env and fill in all required values.
#   cp .env.example .env
# NEVER commit the .env file — it contains secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# PATH CONFIGURATION
# Relative paths are resolved from the docker-compose.yml directory.
# Use forward slashes even on Windows (Docker Desktop handles translation).
# Example absolute path: CONFIG_ROOT=C:/Projects/arrlab/config
# -----------------------------------------------------------------------------
CONFIG_ROOT=./config
DATA_ROOT=./data

# -----------------------------------------------------------------------------
# USER / GROUP IDs
# On Linux: run `id` to find your UID/GID and set them here.
# On Windows with Docker Desktop: 1000:1000 is typically fine.
# -----------------------------------------------------------------------------
PUID=1000
PGID=1000

# -----------------------------------------------------------------------------
# TIMEZONE
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Example: America/New_York, Europe/London, America/Chicago
# -----------------------------------------------------------------------------
TZ=America/New_York

# -----------------------------------------------------------------------------
# PROTONVPN WIREGUARD — REQUIRED
#
# How to get your WireGuard private key:
#   1. Go to account.proton.me → VPN → WireGuard configuration
#   2. Select platform: Router
#   3. Choose your server country/region
#   4. Click Create, then Download the .conf file
#   5. Open the .conf file — copy the value after "PrivateKey = "
#   6. Paste it below (the long base64 string)
#
# Note: gluetun fetches ProtonVPN server endpoints automatically.
# You only need the private key — not the full .conf file.
# -----------------------------------------------------------------------------
WIREGUARD_PRIVATE_KEY=PASTE_YOUR_WIREGUARD_PRIVATE_KEY_HERE

# VPN server country selection (comma-separated for multiple options)
# Examples: Netherlands, Switzerland, Iceland, Sweden
VPN_SERVER_COUNTRIES=Netherlands

# ProtonVPN port forwarding — set to "on" for private tracker seeding
# Requires a ProtonVPN plan that supports port forwarding
VPN_PORT_FORWARDING=off

# -----------------------------------------------------------------------------
# TRAEFIK — REQUIRED
#
# BASE_DOMAIN: the subdomain base all services will live under.
#   Example: if your domain is example.com and you want services at
#   sonarr.home.example.com, set BASE_DOMAIN=home.example.com
#
# ACME_EMAIL: your email address for Let's Encrypt certificate notices.
#
# CF_DNS_API_TOKEN: Cloudflare API token for DNS-01 challenge.
#   How to create one:
#     1. Go to dash.cloudflare.com → My Profile → API Tokens
#     2. Click "Create Token"
#     3. Use the "Edit zone DNS" template
#     4. Under Zone Resources, select your specific domain
#     5. Click "Continue to summary" → "Create Token"
#
# TRAEFIK_DASHBOARD_AUTH: bcrypt-hashed credentials for the Traefik dashboard.
#   Generate with: htpasswd -nb admin yourpassword
#   Or via Docker: docker run --rm httpd:alpine htpasswd -nb admin yourpassword
#   Dollar signs ($) in the hash MUST be escaped as $$ in this file.
# -----------------------------------------------------------------------------
BASE_DOMAIN=home.yourdomain.com
ACME_EMAIL=your-email@example.com
CF_DNS_API_TOKEN=PASTE_YOUR_CLOUDFLARE_API_TOKEN_HERE
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$PASTE_HASHED_PASSWORD_HERE

# -----------------------------------------------------------------------------
# SERVICE PORTS
# These are used for direct host access (bypassing Traefik).
# Change these only if you have conflicts on your host machine.
# -----------------------------------------------------------------------------
SABNZBD_PORT=8080
QBIT_PORT=8090
QBIT_TORRENT_PORT=6881
PROWLARR_PORT=9696
SONARR_PORT=8989
RADARR_PORT=7878
LIDARR_PORT=8686
JELLYFIN_PORT=8096
